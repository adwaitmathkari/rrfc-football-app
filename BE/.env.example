# Shared by both backends (Node reads it with dotenv, Spring Boot imports it via spring.config.import).
# Copy to BE/.env and change the secrets.

NODE_PORT=4000
JAVA_PORT=8080

# Both backends must use the SAME secrets so tokens issued by one are accepted by the other.
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGIN=http://localhost:5173
# Set to true when serving over HTTPS
COOKIE_SECURE=false

DYNAMODB_ENDPOINT=http://localhost:8000
AWS_REGION=ap-south-1
# DynamoDB Local accepts any credentials
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
TABLE_PREFIX=football_

# Used by `npm run seed:admin` (BE/node) to create the first admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_PHONE=9999999999
